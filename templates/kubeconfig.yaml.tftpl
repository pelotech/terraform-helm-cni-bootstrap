# Kubeconfig for the node poll: the API endpoint and CA, with the exec plugin or the client certificate.
apiVersion: v1
kind: Config
clusters:
  - name: cluster
    cluster:
      server: ${jsonencode(cluster_endpoint)}
      certificate-authority-data: ${jsonencode(cluster_ca_certificate)}
users:
  - name: user
    user:
%{ if kube_exec != null ~}
      exec:
        apiVersion: ${jsonencode(kube_exec.api_version)}
        command: ${jsonencode(kube_exec.command)}
        args: ${jsonencode(kube_exec.args)}
        env: ${jsonencode([for name, value in kube_exec.env : { name = name, value = value }])}
        interactiveMode: Never
        provideClusterInfo: false
%{ else ~}
      client-certificate-data: ${jsonencode(client_certificate)}
      client-key-data: ${jsonencode(client_key)}
%{ endif ~}
contexts:
  - name: cluster
    context:
      cluster: cluster
      user: user
current-context: cluster
