# Module defaults for the kube-ovn-v2 chart. Override keys with helm_set or helm_values.
# The pinger checks reach 8.8.8.8 and google.com; override them on private clusters.
central:
  resources:
    requests:
      cpu: "1"
      memory: "768Mi"
agent:
  resources:
    requests:
      memory: "256Mi"
    limits:
      memory: "256Mi"
ovsOvn:
  resources:
    requests:
      memory: "512Mi"
    limits:
      memory: "512Mi"
  # Replace OVS on one node at a time without requiring CPU for a second pod.
  updateStrategy:
    type: RollingUpdate
    maxSurge: 0
    maxUnavailable: 1
networking:
  services:
    cidr:
      v4: "${service_cidr}"
%{ if pod_cidr != "" ~}
  pods:
    cidr:
      v4: "${pod_cidr}"
    gateways:
      v4: "${pod_gateway}"
%{ endif ~}
pinger:
  targets:
    externalAddresses:
      v4: "8.8.8.8"
    externalDomain:
      v4: "google.com."
%{ if master_label_key != "" ~}
masterNodesLabels:
  "${master_label_key}": "${master_label_value}"
%{ endif ~}
controller:
  resources:
    requests:
      memory: "1536Mi"
    limits:
      memory: "1536Mi"
%{ if master_label_key != "" ~}
  # Pin kube-ovn-controller next to ovn-central on the master node.
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      - matchExpressions:
          - key: "${master_label_key}"
            operator: In
            values: ["${master_label_value}"]
%{ endif ~}
